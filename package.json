{
  "name": "grpc-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "backend"
  ],
  "scripts": {
    "check:protos": "node scripts/check-protos.js",
    "report": "npm start -w @grpc-inventory/report",
    "audit": "npm start -w @grpc-inventory/audit",
    "services": "node scripts/start-services.js",
    "cli": "npm start -w @grpc-inventory/backend",
    "test": "node --test"
  },
  "dependencies": {
    "@grpc/proto-loader": "^0.8.1"
  }
}
